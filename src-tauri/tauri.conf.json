{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "bookbookbook",
  "version": "../package.json",
  "identifier": "io.github.nichkt.bookbookbook",
  "build": {
    "frontendDist": "../dist-desktop",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev:desktop",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "bookbookbook",
        "width": 1280,
        "height": 860,
        "minWidth": 360,
        "minHeight": 480,
        "center": true,
        "dragDropEnabled": false,
        "backgroundColor": "#f4efe6",
        "visible": false,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Nicholas Ton",
    "copyright": "Copyright © 2026 Nicholas Ton",
    "category": "Productivity",
    "shortDescription": "Plan your novel chapter by chapter, then write each chapter with your plan beside the page.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE2MUFGRjhFNEVDN0IyNUMKUldSY3NzZE9qdjhhRnFOSkVDTmRqdjFRWHd5K3lTZFpPREs4U25sdnp5RkJkci96blZrQm9hTmcK",
      "endpoints": [
        "https://github.com/Nichkt/bookbookbook/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
